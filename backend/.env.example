# Gemini API Key (obtain free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key

# Supported Gemini Model (e.g. gemini-1.5-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Backend Server Port
SERVER_PORT=8080

# Allowed Frontend Origin for CORS (comma-separated if multiple)
FRONTEND_ORIGIN=http://localhost:5173
